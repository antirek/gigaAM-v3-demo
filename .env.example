# Model (official gigaam package names)
MODEL_NAME=v3_e2e_rnnt
DEVICE=cpu

# Model weights cache (bind-mounted into container, ~450 MB per checkpoint)
GIGAAM_CACHE=./data/gigaam

# Limits
# Batch upload max length (streaming uses sliding segments and has no hard stop)
MAX_AUDIO_SECONDS=300
# How often to refresh partial transcript in stream mode
STREAM_CHUNK_SECONDS=3
# Commit a finished segment every N seconds of audio
STREAM_SEGMENT_SECONDS=12

# Live diarization (stream only): Charoite-style pyannote-seg + ERes2Net
DIAR_ENABLED=true
DIAR_MAX_SPEAKERS=2
DIAR_THRESHOLD=0.62
# Min speech length to create Speakers 2; shorter if embedding is far from Speakers 1
DIAR_MIN_NEW_SEC=0.8
# Relative cosine margin to switch between already-known speakers
DIAR_SWITCH_MARGIN=0.08
# How strongly to keep Speakers 1 before opening Speakers 2
DIAR_STICKY=0.08
# Pause (sec) after which a new span is treated as a likely turn change
DIAR_TURN_GAP=0.35
DIAR_EMB_MODEL=/data/diar/embedding.onnx
DIAR_SEG_MODEL=/data/diar/segmentation.onnx
