# Model (official gigaam package names)
MODEL_NAME=v3_e2e_rnnt
DEVICE=cpu

# Model weights cache (bind-mounted into container, ~450 MB per checkpoint)
GIGAAM_CACHE=./data/gigaam

# Limits
MAX_AUDIO_SECONDS=300
STREAM_CHUNK_SECONDS=3
STREAM_SEGMENT_SECONDS=12

# Live diarization (stream only): off | sherpa | diart
# diart = online speech regions (diart) + ERes2Net speaker IDs (same assigner as sherpa)
DIAR_BACKEND=sherpa
DIAR_ENABLED=true
DIAR_MAX_SPEAKERS=2

# --- speaker assignment (sherpa + diart hybrid) ---
DIAR_THRESHOLD=0.62
DIAR_MIN_NEW_SEC=0.8
DIAR_SWITCH_MARGIN=0.08
DIAR_STICKY=0.08
DIAR_TURN_GAP=0.35
DIAR_EMB_MODEL=/data/diar/embedding.onnx
DIAR_SEG_MODEL=/data/diar/segmentation.onnx

# --- diart speech segmentation (gated pyannote; needs token) ---
# DIAR_HF_TOKEN=hf_...
DIAR_DIART_SEG_MODEL=pyannote/segmentation-3.0
DIAR_DIART_EMB_MODEL=pyannote/embedding
DIAR_DIART_DURATION=5
DIAR_DIART_STEP=0.5
DIAR_DIART_LATENCY=2.0
DIAR_DIART_TAU_ACTIVE=0.45
DIAR_DIART_RHO_UPDATE=0.15
DIAR_DIART_DELTA_NEW=0.5
DIAR_DIART_MIN_TURN=0.7
DIAR_DIART_TURN_GAP=0.35
DIAR_DIART_MAX_FRAG=0.9
DIAR_DIART_CACHE=/data/diart
